# Copy to .env and fill. Never commit .env.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=basamak
DB_USER=basamak
DB_PASSWORD=change-me
TEST_DB_NAME=basamak_test
# Base64, >= 64 bytes
JWT_SECRET=change-me-base64
# Base64, 32 bytes (AES-256-GCM master key for tool/TOTP secrets)
ENCRYPTION_KEY=change-me-base64-32-bytes
# HMAC key for certificate signatures
CERT_SECRET=change-me
SMTP_HOST=localhost
SMTP_PORT=1025
WEB_BASE_URL=http://localhost:5173
CMS_BASE_URL=http://localhost:5174
API_BASE_URL=http://localhost:8080
# mock | ollama
AI_PROVIDER=mock
# Tools (F3): local mock API key (fake, not a secret), staff-only trusted host:port list, worker threads
MOCK_API_KEY=demo-mock-key
TOOLS_TRUSTED_HOSTS=localhost:8090,127.0.0.1:8090
JOB_WORKERS=4

# Uploaded lesson media directory (relative to where the backend is started; data/ is gitignored)
MEDIA_DIR=data/media

# AI provider: mock (default, free, deterministic) or ollama (free local server, not verified here)
AI_PROVIDER=mock
# AI_MONTHLY_BUDGET_USD=1.00

# Tool file outputs (non-JSON answers up to 50 MB, kept 7 days)
TOOLS_OUTPUT_DIR=data/tool-outputs
