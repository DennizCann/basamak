# Copy to .env and fill. Never commit .env.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=basamak
DB_USER=basamak
DB_PASSWORD=change-me
TEST_DB_NAME=basamak_test
# Base64, >= 64 bytes
JWT_SECRET=change-me-base64
# Base64, 32 bytes (AES-256-GCM master key for tool/TOTP secrets)
ENCRYPTION_KEY=change-me-base64-32-bytes
# HMAC key for certificate signatures
CERT_SECRET=change-me
SMTP_HOST=localhost
SMTP_PORT=1025
WEB_BASE_URL=http://localhost:5173
CMS_BASE_URL=http://localhost:5174
API_BASE_URL=http://localhost:8080
# mock | ollama
AI_PROVIDER=mock
