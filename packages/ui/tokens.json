{
  "$description": "Single source of design tokens for web, CMS and mobile. Run `npm run tokens` to regenerate tokens.css.",
  "font": {
    "family": "system-ui, -apple-system, 'Segoe UI', Roboto, 'Noto Sans', sans-serif",
    "mono": "ui-monospace, 'Cascadia Code', Consolas, monospace",
    "size-xs": "0.75rem", "size-sm": "0.875rem", "size-md": "1rem", "size-lg": "1.25rem", "size-xl": "1.5rem", "size-2xl": "2rem",
    "weight-regular": "400", "weight-semibold": "600", "weight-bold": "700",
    "line-height": "1.5"
  },
  "space": { "1": "0.25rem", "2": "0.5rem", "3": "0.75rem", "4": "1rem", "5": "1.5rem", "6": "2rem", "8": "3rem" },
  "radius": { "sm": "4px", "md": "8px", "lg": "12px", "pill": "999px" },
  "motion": { "fast": "120ms", "base": "200ms", "easing": "cubic-bezier(0.2, 0, 0, 1)" },
  "size": { "touch-target": "48px", "content-max": "72rem" },
  "color": {
    "light": {
      "bg": "#f7f7f9", "surface": "#ffffff", "surface-2": "#eef0f4", "border": "#c9ced8",
      "text": "#14171f", "text-muted": "#4a5263",
      "primary": "#3a2fd6", "primary-contrast": "#ffffff", "primary-soft": "#e7e5ff",
      "success": "#116b33", "warning": "#8a5300", "danger": "#b3261e", "info": "#0b5cad",
      "focus": "#3a2fd6", "shadow": "0 1px 3px rgba(20,23,31,.12), 0 4px 12px rgba(20,23,31,.06)"
    },
    "dark": {
      "bg": "#0f1117", "surface": "#181b24", "surface-2": "#222632", "border": "#3a4050",
      "text": "#eef0f5", "text-muted": "#b2b9c8",
      "primary": "#a7a1ff", "primary-contrast": "#0f1117", "primary-soft": "#2b2752",
      "success": "#6fdc95", "warning": "#f2c36b", "danger": "#ff8a80", "info": "#8cc4ff",
      "focus": "#c7c3ff", "shadow": "0 1px 3px rgba(0,0,0,.5), 0 4px 12px rgba(0,0,0,.35)"
    }
  }
}
