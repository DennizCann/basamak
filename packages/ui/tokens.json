{
  "$description": "Single source of design tokens for web, CMS and mobile. Run `npm run tokens` to regenerate tokens.css.",
  "font": {
    "family": "system-ui, -apple-system, 'Segoe UI', Roboto, 'Noto Sans', sans-serif",
    "mono": "ui-monospace, 'Cascadia Code', Consolas, monospace",
    "size-xs": "0.75rem", "size-sm": "0.875rem", "size-md": "1rem", "size-lg": "1.125rem", "size-xl": "1.25rem", "size-2xl": "1.5rem", "size-3xl": "2rem",
    "weight-regular": "400", "weight-medium": "500", "weight-semibold": "600", "weight-bold": "700",
    "line-height": "1.5", "line-height-reading": "1.7", "measure": "68ch"
  },
  "space": { "1": "0.25rem", "2": "0.5rem", "3": "0.75rem", "4": "1rem", "5": "1.5rem", "6": "2rem", "7": "2.5rem", "8": "3rem" },
  "radius": { "sm": "6px", "md": "10px", "lg": "14px", "pill": "999px" },
  "motion": { "fast": "120ms", "base": "200ms", "easing": "cubic-bezier(0.2, 0, 0, 1)" },
  "size": { "touch-target": "48px", "content-max": "72rem", "header": "60px" },
  "color": {
    "light": {
      "bg": "#f6f6f8", "surface": "#ffffff", "surface-2": "#eeeff3", "border": "#d4d7df", "border-strong": "#9aa1b1",
      "text": "#14171f", "text-muted": "#4a5263",
      "primary": "#3b30c9", "primary-hover": "#2f25ad", "primary-contrast": "#ffffff", "primary-soft": "#ebe9ff", "primary-text": "#3329b8",
      "success": "#126b34", "success-soft": "#e3f4e8", "warning": "#8a5300", "warning-soft": "#fdf1dc", "danger": "#b3261e", "info": "#0b5cad", "info-soft": "#e4effb",
      "focus": "#3b30c9", "shadow": "0 1px 2px rgba(20,23,31,.06), 0 2px 8px rgba(20,23,31,.04)"
    },
    "dark": {
      "bg": "#0f1117", "surface": "#171a22", "surface-2": "#20242f", "border": "#323847", "border-strong": "#5b6376",
      "text": "#eef0f5", "text-muted": "#b2b9c8",
      "primary": "#a7a1ff", "primary-hover": "#bbb6ff", "primary-contrast": "#0f1117", "primary-soft": "#28244d", "primary-text": "#bdb8ff",
      "success": "#6fdc95", "success-soft": "#16301f", "warning": "#f2c36b", "warning-soft": "#33280f", "danger": "#ff8a80", "info": "#8cc4ff", "info-soft": "#132a42",
      "focus": "#c7c3ff", "shadow": "0 1px 2px rgba(0,0,0,.4)"
    }
  }
}
