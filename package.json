{
  "name": "basamak",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "packages/*",
    "apps/web",
    "apps/cms",
    "apps/mobile"
  ],
  "scripts": {
    "tokens": "node packages/ui/scripts/build-tokens.mjs",
    "dev:web": "npm run dev -w apps/web",
    "dev:cms": "npm run dev -w apps/cms",
    "build": "npm run tokens && npm run build -w apps/web -w apps/cms",
    "typecheck": "npm run typecheck -w apps/web -w apps/cms",
    "e2e": "playwright test -c e2e/playwright.config.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.49.1"
  }
}
